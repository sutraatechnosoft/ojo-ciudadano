# Copia este archivo a .env.local y completa los valores
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anon-publica

# SOLO servidor. NUNCA con prefijo NEXT_PUBLIC_. Se usa para recibir reportes públicos.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role
# Cualquier texto largo y aleatorio: sal para anonimizar IPs en el límite de reportes
RATE_LIMIT_SALT=cambia-esto-por-un-texto-aleatorio

# Opcional: centro y zoom inicial del mapa (por defecto, vista mundial)
# NEXT_PUBLIC_MAP_LAT=-33.4489
# NEXT_PUBLIC_MAP_LON=-70.6693
# NEXT_PUBLIC_MAP_ZOOM=11
